# DRISHTI Environment Variables
# Copy this file to .env and configure as needed

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./ibvap.db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional: Webhook endpoint for critical alerts
WEBHOOK_URL=http://your-c2-server.com/api/alerts

# Optional: Set to 'true' to use CUDA/GPU if available
USE_GPU=false

# --- Email alerts (task 1.2) -------------------------------------------
# Leave SMTP_HOST blank to disable email; the channel then logs and skips,
# so a fresh clone still boots with no configuration.
# For Gmail use an App Password (not your account password) with 2FA on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Defaults to SMTP_USER when omitted
SMTP_FROM=DRISHTI Command <you@gmail.com>
# Comma-separated list of recipients
SMTP_TO=commander@example.com,duty-officer@example.com
# STARTTLS on 587 (default). Set SMTP_USE_SSL=true for implicit TLS on 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
