# DRISHTI Environment Variables
# Copy this file to .env and configure as needed

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./ibvap.db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional: Webhook endpoint for critical alerts
WEBHOOK_URL=http://your-c2-server.com/api/alerts

# Optional: Set to 'true' to use CUDA/GPU if available
USE_GPU=false
